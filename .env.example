# Google GenAI / Vertex AI configuration
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=gcp_project_id
GOOGLE_CLOUD_LOCATION=global

# Google AI Studio API Key (used if GOOGLE_GENAI_USE_VERTEXAI=False)
GOOGLE_API_KEY=

# Extraction & Classification model for the support workflow
SUPPORT_MODEL=gemini-2.5-flash

# Optional Gemini Live settings
# SUPPORT_GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio (or gemini-3.8-live on AI Studio)
SUPPORT_VOICE=Aoede

# Server port and CORS
SUPPORT_PORT=4188
SUPPORT_CORS_ORIGINS=http://127.0.0.1:4188,http://localhost:4188
